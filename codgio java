### Código en Java

```java
import java.util.Scanner;
import java.util.ArrayList;

public class Floristeria {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        String[] flores = {"rosa", "tulipan", "girasol", "amapola", "lirio"};
        int[] cantidad = {1, 17, 3, 8, 5};
        int[] precio = {4000, 80000, 5000, 15000, 23000};

        ArrayList<String> carritoFlores = new ArrayList<>();
        ArrayList<Integer> carritoCantidades = new ArrayList<>();
        ArrayList<Integer> carritoPrecios = new ArrayList<>();
        ArrayList<Integer> carritoSubtotales = new ArrayList<>();

        System.out.println("Bienvenido a mi floristeria\n");

        int opc = 0;
        while (opc != 5) {
            System.out.println("\nMenú:");
            System.out.println("1. Consultar flores");
            System.out.println("2. Comprar flores");
            System.out.println("3. Pagar");
            System.out.println("4. Factura de compra");
            System.out.println("5. Salir");
            System.out.print("Ingrese su opción: ");

            opc = scanner.nextInt();

            if (opc == 1) {
                System.out.println("\nEstas son nuestras flores disponibles:");
                System.out.println("N° | Flores | Cantidad | Precio");
                for (int i = 0; i < flores.length; i++) {
                    System.out.println((i + 1) + " | " + flores[i] + " | " + cantidad[i] + " | $" + precio[i]);
                }

            } else if (opc == 2) {
                System.out.println("\n--- Comprar Flores ---");
                for (int i = 0; i < flores.length; i++) {
                    System.out.println((i + 1) + ". " + flores[i] + " (Disponibles: " + cantidad[i] + " Precio: $" + precio[i] + ")");
                }

                System.out.print("Seleccione el número de la flor que desea comprar: ");
                int seleccion = scanner.nextInt() - 1;

                if (seleccion >= 0 && seleccion < flores.length) {
                    System.out.print("¿Cuántas unidades desea? ");
                    int cantDeseada = scanner.nextInt();

                    if (cantDeseada <= 0) {
                        System.out.println("La cantidad debe ser mayor a 0.");
                    } else if (cantDeseada <= cantidad[seleccion]) {
                        cantidad[seleccion] = cantidad[seleccion] - cantDeseada;
                        int subtotal = cantDeseada * precio[seleccion];

                        carritoFlores.add(flores[seleccion]);
                        carritoCantidades.add(cantDeseada);
                        carritoPrecios.add(precio[seleccion]);
                        carritoSubtotales.add(subtotal);

                        System.out.println("¡Se han agregado al carrito!");
                    } else {
                        System.out.println("No hay suficiente stock disponible.");
                    }
                } else {
                    System.out.println("Selección inválida.");
                }

            } else if (opc == 3) {
                if (carritoFlores.size() == 0) {
                    System.out.println("\nEl carrito está vacío. Agregue flores primero.");
                } else {
                    int total = 0;
                    for (int i = 0; i < carritoSubtotales.size(); i++) {
                        total = total + carritoSubtotales.get(i);
                    }
                    System.out.println("\nProcesando el pago de: $" + total);
                    System.out.println("¡Pago realizado con éxito!");

                    carritoFlores.clear();
                    carritoCantidades.clear();
                    carritoPrecios.clear();
                    carritoSubtotales.clear();
                }

            } else if (opc == 4) {
                System.out.println("\nFactura de Compra");
                if (carritoFlores.size() == 0) {
                    System.out.println("No tienes productos en el carrito actualmente.");
                } else {
                    int total = 0;
                    System.out.println("Flor | Cant. | P. Unitario | Subtotal");
                    System.out.println("----------------------------------------");
                    for (int i = 0; i < carritoFlores.size(); i++) {
                        System.out.println(carritoFlores.get(i) + " | " + carritoCantidades.get(i) + " | $" + carritoPrecios.get(i) + " | $" + carritoSubtotales.get(i));
                        total = total + carritoSubtotales.get(i);
                    }
                    System.out.println("----------------------------------------");
                    System.out.println("TOTAL A PAGAR: $" + total);
                }

            } else if (opc == 5) {
                System.out.println("Gracias por su visita. ¡Vuelva pronto!");

            } else {
                System.out.println("Opción no válida");
            }
        }
    }
}

